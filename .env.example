# Copier vers apps/api/.env et apps/web/.env.local
# Ne jamais committer de secrets réels.

# API
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://tiptop:tiptop@localhost:5432/tiptop
REDIS_URL=redis://127.0.0.1:6379
SESSION_SECRET=change-me-in-production-use-a-long-random-string
OTP_MOCK_CODE=1234
OTP_EXPIRY_SECONDS=90
OTP_MAX_ATTEMPTS=5

# WEB
NEXT_PUBLIC_API_URL=http://localhost:3001
