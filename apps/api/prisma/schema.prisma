generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
  FINANCE_ADMIN
  SUPPORT_ADMIN
  CONTENT_ADMIN
  ANALYTICS_ADMIN
  TECH_ADMIN
}

enum OrganizerStatus {
  NONE
  PENDING
  VERIFIED
  RESTRICTED
  SUSPENDED
  REJECTED
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

enum Availability {
  HIDDEN
  BUSY
  AVAILABLE
}

enum LocationPrecision {
  EXACT
  ZONE
  CITY
  HIDDEN
}

enum PostKind {
  ORGANIC
  SPONSORED
}

enum LikeUnitSource {
  FREE
  PURCHASED
  CERTIFIED_BONUS
}

model AppConfig {
  key   String @id
  value Json
}

model User {
  id               String     @id @default(cuid())
  phoneE164        String     @unique
  phoneCountry     String     @default("CM")
  email            String?    @unique
  username         String     @unique
  firstName        String
  lastName         String
  role             UserRole   @default(USER)
  status           UserStatus @default(ACTIVE)
  organizerStatus  OrganizerStatus @default(NONE)
  salesBlocked     Boolean    @default(false)
  certified        Boolean    @default(false)
  profileCompleted Boolean    @default(false)
  locale           String     @default("fr")
  theme            String     @default("light")
  currency         String     @default("CAD")
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deletedAt        DateTime?

  profile        Profile?
  sessions       Session[]
  devices        Device[]
  otpChallenges  OtpChallenge[]
  posts              Post[]
  likeUnits          LikeUnit[]
  likeReceived       LikeAllocation[] @relation("LikeReceived")
  likePeriodsMade    LikePeriod[]     @relation("LikePeriodActor")
  likePeriodsReceived LikePeriod[]    @relation("LikePeriodBeneficiary")
  likeMilestones     UserMilestone[]
  likeStats          UserLikeStats?
  wishes             Wish[]
  wishOffersMade     WishOffer[]      @relation("WishOfferFrom")
  socialInvitesSent     SocialInvite[]   @relation("SocialInviteFrom")
  socialInvitesReceived SocialInvite[]   @relation("SocialInviteTo")
  likePurchases      LikePurchase[]
  likeTransactions   LikeTransaction[] @relation("LikeTxOwner")
  likeTxReceived     LikeTransaction[] @relation("LikeTxTarget")
  payments           Payment[]
  comments           Comment[]
  following          Follow[]         @relation("Following")
  followers          Follow[]         @relation("Followers")
  notifications      Notification[]   @relation("NotifRecipient")
  notificationsActed Notification[]   @relation("NotifActor")
  hostedEvents       Event[]              @relation("EventHost")
  eventParticipations EventParticipant[]
  sentInvitations    Invitation[]         @relation("Inviter")
  receivedInvitations Invitation[]        @relation("Invitee")
  eventHearts        EventHeart[]
  moods              Mood[]
  moodCompanionOf    Mood[]               @relation("MoodCompanion")
  moodComments       MoodComment[]
  contactsOwned      Contact[]            @relation("ContactOwner")
  contactsOf         Contact[]            @relation("ContactPerson")
  inviteLaterOwned   InviteLater[]        @relation("InviteLaterOwner")
  inviteLaterOf      InviteLater[]        @relation("InviteLaterPerson")
  reservations       Reservation[]
  tickets            Ticket[]
  paymentMethods     PaymentMethod[]
  conversationMembers ConversationMember[]
  messages           Message[]
  blocksMade         UserBlock[]          @relation("Blocker")
  blocksReceived     UserBlock[]          @relation("Blocked")
  reportsMade        Report[]             @relation("Reporter")
  reportsAbout       Report[]             @relation("ReportTarget")
  reportsReviewed    Report[]             @relation("ReportReviewer")
  adminAudits        AdminAudit[]
  pushPreference     PushPreference?
  eventReviews       EventReview[]
  offers             Offer[]
  eventGroupsCreated EventGroup[]         @relation("EventGroupCreator")
  eventGroupMembers  EventGroupMember[]
  eventGroupInvites  EventGroupMember[]   @relation("EventGroupInviter")
  aiConsent          AiConsent?
  preferenceProfile  UserPreferenceProfile?
  preferenceSignals  PreferenceSignal[]
  experienceRequests ExperienceRequest[]
  experiencePlans    ExperiencePlan[]
  experienceRecs     ExperienceRecommendation[]
  recFeedbacks       RecommendationFeedback[]
  socialMatches      SocialActivityMatch[] @relation("MatchViewer")
  socialMatchesOf    SocialActivityMatch[] @relation("MatchPeer")
  activityGroups     ActivityGroup[]
  agentSuggestions   AgentSuggestion[]
  worldProgress      UserWorldProgress?
  cityDiscoveries    CityDiscoveryProgress[]
  categoryDiscoveries CategoryDiscoveryProgress[]
  userAchievements   UserAchievement[]
  userMissions       UserMission[]
  experienceFeedbacks ExperienceFeedback[]
  adminCampaigns     AdminCampaign[]
}

model Profile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio                String?
  profession         String?
  avatarUrl          String?
  coverUrl           String?
  birthDate          DateTime?
  availability       Availability       @default(HIDDEN)
  availabilityUntil  DateTime?
  locationPrecision  LocationPrecision  @default(ZONE)
  country            String             @default("CM")
  city               String?
  zone               String?
  latitude           Float?
  longitude          Float?
  website            String?
  interests          String[]           @default([])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  rememberMe Boolean   @default(false)
  userAgent  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model OtpChallenge {
  id         String    @id @default(cuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  phoneE164  String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phoneE164, createdAt])
}

model Device {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushToken  String?
  platform   String
  lastSeenAt DateTime @default(now())

  @@unique([userId, platform])
}

model Post {
  id        String    @id @default(cuid())
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  kind      PostKind  @default(ORGANIC)
  imageUrl  String?
  imageUrls Json?
  city      String?
  zone      String?
  eventId   String?
  event     Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  hiddenAt  DateTime?
  createdAt DateTime  @default(now())
  comments  Comment[]
  reports   Report[]

  @@index([createdAt])
  @@index([hiddenAt])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
}

model LikeUnit {
  id                   String         @id @default(cuid())
  ownerId              String
  owner                User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  source               LikeUnitSource @default(FREE)
  purchaseId           String?
  purchase             LikePurchase?  @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  createdAt            DateTime       @default(now())
  allocations          LikeAllocation[]
  transactions         LikeTransaction[]
  periods              LikePeriod[]

  @@index([ownerId])
  @@index([purchaseId])
}

enum PaymentKind {
  RESERVATION
  LIKE_PACK
}

enum LikeTransactionKind {
  PURCHASE
  ALLOCATE
  RELEASE
}

model LikePurchase {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  packCode  String
  units     Int
  amountXaf Int
  createdAt DateTime          @default(now())
  payment   Payment?
  unitsMade LikeUnit[]
  ledger    LikeTransaction[]

  @@index([userId, createdAt])
}

model LikeTransaction {
  id         String               @id @default(cuid())
  userId     String
  user       User                 @relation("LikeTxOwner", fields: [userId], references: [id], onDelete: Cascade)
  kind       LikeTransactionKind
  delta      Int                  @default(0)
  unitId     String?
  unit       LikeUnit?            @relation(fields: [unitId], references: [id], onDelete: SetNull)
  toUserId   String?
  toUser     User?                @relation("LikeTxTarget", fields: [toUserId], references: [id], onDelete: SetNull)
  purchaseId String?
  purchase   LikePurchase?        @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  createdAt  DateTime             @default(now())

  @@index([userId, createdAt])
}

enum NotificationType {
  LIKE
  COMMENT
  FOLLOW
  INVITE
  TICKET
  PAYMENT
  MESSAGE
  REVIEW
  WISH_OFFER
  LIKE_MILESTONE
  SOCIAL_INVITE
  EVENT_UPDATE
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  ENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REFUSED
  EXPIRED
  CANCELLED
}

enum InvitationPayer {
  HOST
  GUEST
  FREE
}

enum ParticipantStatus {
  HOST
  INTERESTED
  RESERVED
  CONFIRMED
  PRESENT
  CANCELLED
}

enum MoodKind {
  MOOD
  STATUS
}

enum MoodVisibility {
  ZONE
  FOLLOWERS
  EVENT
  PUBLIC
}

enum TicketStatus {
  DRAFT
  AWAITING_PAYMENT
  CONFIRMED
  CONSUMED
  CANCELLED
  REFUNDED
  EXPIRED
  INVALID
}

enum PaymentProvider {
  CARD
  ORANGE_MONEY
  MTN_MOMO
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ReservationStatus {
  DRAFT
  AWAITING_PAYMENT
  CONFIRMED
  CANCELLED
  PAST
}

model Follow {
  id         String   @id @default(cuid())
  followerId String
  followeeId String
  follower   User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  followee   User     @relation("Followers", fields: [followeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([followerId, followeeId])
  @@index([followeeId])
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation("NotifRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?            @relation("NotifActor", fields: [actorId], references: [id], onDelete: SetNull)
  type       NotificationType
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  @@index([userId, createdAt])
}

model LikeAllocation {
  id           String    @id @default(cuid())
  unitId       String
  unit         LikeUnit  @relation(fields: [unitId], references: [id], onDelete: Cascade)
  toUserId     String
  toUser       User      @relation("LikeReceived", fields: [toUserId], references: [id], onDelete: Cascade)
  allocatedAt  DateTime  @default(now())
  releasedAt   DateTime?

  @@index([unitId, releasedAt])
  @@index([toUserId, releasedAt])
}

enum LikeTargetType {
  USER
  POST
  COMMENT
  MOOD
  WISH
}

model LikePeriod {
  id                 String         @id @default(cuid())
  unitId             String
  unit               LikeUnit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  actorId            String
  actor              User           @relation("LikePeriodActor", fields: [actorId], references: [id], onDelete: Cascade)
  targetType         LikeTargetType
  targetId           String
  beneficiaryUserId  String
  beneficiary        User           @relation("LikePeriodBeneficiary", fields: [beneficiaryUserId], references: [id], onDelete: Cascade)
  startedAt          DateTime
  endedAt            DateTime?
  weight             Int            @default(1)

  @@index([targetType, targetId, endedAt])
  @@index([beneficiaryUserId, endedAt])
  @@index([actorId, endedAt])
  @@index([unitId, endedAt])
}

model UserMilestone {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestoneId String
  achievedAt  DateTime @default(now())
  notifiedAt  DateTime?

  @@unique([userId, milestoneId])
  @@index([userId])
}

model UserLikeStats {
  userId        String   @id
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  closedSeconds Int      @default(0)
  updatedAt     DateTime @updatedAt
}

enum WishCategory {
  EVENT
  PRODUCT
  RESTAURANT
  ACTIVITY
  TRAVEL
  EXPERIENCE
  GIFT
  SERVICE
  PLACE
  SPORT
  LEISURE
  OTHER
}

enum WishVisibility {
  PUBLIC
  FOLLOWERS
  PRIVATE
}

enum WishPriority {
  LOW
  MEDIUM
  HIGH
}

enum WishOfferStatus {
  SENT
  PENDING
  ACCEPTED
  REFUSED
  AWAITING_PAYMENT
  PAID
  DELIVERED
  DONE
  CANCELLED
}

model Wish {
  id                 String         @id @default(cuid())
  ownerId            String
  owner              User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title              String
  category           WishCategory   @default(OTHER)
  description        String         @default("")
  imageUrl           String?
  url                String?
  estimatedPriceXaf  Int?
  city               String?
  zone               String?
  desiredAt          DateTime?
  eventId            String?
  priority           WishPriority   @default(MEDIUM)
  visibility         WishVisibility @default(PUBLIC)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  offers             WishOffer[]
  socialInvites      SocialInvite[]

  @@index([ownerId, createdAt])
}

enum SocialInviteContext {
  RESTAURANT
  CAFE
  ACTIVITY
  MEETUP
  WISH
}

enum SocialInviteStatus {
  SENT
  ACCEPTED
  REFUSED
  EXPIRED
  CANCELLED
}

model SocialInvite {
  id          String              @id @default(cuid())
  inviterId   String
  inviter     User                @relation("SocialInviteFrom", fields: [inviterId], references: [id], onDelete: Cascade)
  inviteeId   String
  invitee     User                @relation("SocialInviteTo", fields: [inviteeId], references: [id], onDelete: Cascade)
  context     SocialInviteContext
  label       String              @default("")
  message     String              @default("")
  wishId      String?
  wish        Wish?               @relation(fields: [wishId], references: [id], onDelete: SetNull)
  status      SocialInviteStatus  @default(SENT)
  createdAt   DateTime            @default(now())
  respondedAt DateTime?
  expiresAt   DateTime

  @@index([inviteeId, status])
  @@index([inviterId, createdAt])
}

model WishOffer {
  id        String          @id @default(cuid())
  wishId    String
  wish      Wish            @relation(fields: [wishId], references: [id], onDelete: Cascade)
  fromUserId String
  fromUser  User            @relation("WishOfferFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  message   String          @default("")
  status    WishOfferStatus @default(SENT)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([wishId, createdAt])
  @@index([fromUserId])
}

model Event {
  id                  String      @id @default(cuid())
  hostId              String
  host                User        @relation("EventHost", fields: [hostId], references: [id], onDelete: Cascade)
  title               String
  description         String      @default("")
  imageUrl            String?
  city                String
  zone                String?
  venue               String?
  address             String?
  latitude            Float?
  longitude           Float?
  startsAt            DateTime
  endsAt              DateTime?
  priceXaf            Int         @default(0)
  currency            String      @default("XAF")
  capacity            Int?
  minAge              Int?
  requiresReservation Boolean     @default(false)
  paymentRule         String      @default("HOLD")
  wanted              Boolean     @default(false)
  allowGroups         Boolean     @default(false)
  recurrence          String      @default("NONE")
  seriesId            String?
  seriesParent        Event?      @relation("EventSeries", fields: [seriesId], references: [id], onDelete: SetNull)
  seriesChildren      Event[]     @relation("EventSeries")
  status              EventStatus @default(PUBLISHED)
  featured            Boolean     @default(false)
  suspendedAt         DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  participants        EventParticipant[]
  groups              EventGroup[]
  invitations         Invitation[]
  hearts              EventHeart[]
  moods               Mood[]
  posts               Post[]
  reservations        Reservation[]
  tickets             Ticket[]
  conversation        Conversation?
  reports             Report[]
  reviews             EventReview[]

  @@index([startsAt, status])
  @@index([city])
  @@index([seriesId, startsAt])
}

model EventParticipant {
  id        String            @id @default(cuid())
  eventId   String
  event     Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        ParticipantStatus
  showOnProfile Boolean           @default(false)
  createdAt     DateTime          @default(now())

  @@unique([eventId, userId])
}

enum EventGroupRole {
  HOST
  ADMIN
  MEMBER
}

enum EventGroupStatus {
  INVITED
  JOINED
  DECLINED
  LEFT
}

model EventGroup {
  id             String             @id @default(cuid())
  eventId        String
  event          Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name           String
  createdById    String
  createdBy      User               @relation("EventGroupCreator", fields: [createdById], references: [id], onDelete: Cascade)
  conversationId String?            @unique
  createdAt      DateTime           @default(now())
  members        EventGroupMember[]

  @@index([eventId])
}

model EventGroupMember {
  id          String           @id @default(cuid())
  groupId     String
  group       EventGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        EventGroupRole   @default(MEMBER)
  status      EventGroupStatus
  invitedById String?
  invitedBy   User?            @relation("EventGroupInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  @@unique([groupId, userId])
  @@index([userId, status])
}

model Invitation {
  id          String           @id @default(cuid())
  eventId     String
  event       Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  inviterId   String
  inviter     User             @relation("Inviter", fields: [inviterId], references: [id], onDelete: Cascade)
  inviteeId   String
  invitee     User             @relation("Invitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  payer          InvitationPayer
  payAfterAccept Boolean          @default(false)
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  createdAt   DateTime         @default(now())
  respondedAt DateTime?
  reservation Reservation?

  @@index([inviteeId, status])
  @@index([inviterId])
}

model EventHeart {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId    String
  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  releasedAt DateTime?

  @@index([userId, releasedAt])
  @@index([eventId, releasedAt])
}

model Mood {
  id         String         @id @default(cuid())
  authorId   String
  author     User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body       String         @default("")
  imageUrl   String?
  videoUrl   String?
  activity   String?
  city       String?
  zone       String?
  placeName  String?
  address    String?
  latitude   Float?
  longitude  Float?
  eventId    String?
  event      Event?         @relation(fields: [eventId], references: [id], onDelete: SetNull)
  companionId String?
  companion   User?         @relation("MoodCompanion", fields: [companionId], references: [id], onDelete: SetNull)
  kind       MoodKind       @default(MOOD)
  interest   String?
  visibility MoodVisibility @default(PUBLIC)
  soundKey   String?
  soundLabel String?
  expiresAt  DateTime?
  hiddenAt   DateTime?
  createdAt  DateTime       @default(now())
  comments   MoodComment[]
  reports    Report[]

  @@index([expiresAt])
  @@index([kind, expiresAt])
  @@index([hiddenAt])
}

model MoodComment {
  id        String        @id @default(cuid())
  moodId    String
  mood      Mood          @relation(fields: [moodId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    MoodComment?  @relation("MoodCommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   MoodComment[] @relation("MoodCommentThread")
  body      String
  createdAt DateTime      @default(now())

  @@index([moodId, parentId])
}

model Contact {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  personId  String
  person    User     @relation("ContactPerson", fields: [personId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([ownerId, personId])
}

model InviteLater {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation("InviteLaterOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  personId  String
  person    User     @relation("InviteLaterPerson", fields: [personId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([ownerId, personId])
  @@index([ownerId, createdAt])
}

model Reservation {
  id            String            @id @default(cuid())
  eventId       String
  event         Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bookerId      String
  booker        User              @relation(fields: [bookerId], references: [id], onDelete: Cascade)
  invitationId  String?           @unique
  invitation    Invitation?       @relation(fields: [invitationId], references: [id], onDelete: SetNull)
  status        ReservationStatus @default(DRAFT)
  seats         Int               @default(1)
  amountXaf     Int               @default(0)
  currency      String            @default("XAF")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  tickets       Ticket[]
  payment       Payment?

  @@index([bookerId, createdAt])
  @@index([eventId, status])
}

model Ticket {
  id             String       @id @default(cuid())
  reservationId  String
  reservation    Reservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  eventId        String
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  holderId       String
  holder         User         @relation(fields: [holderId], references: [id], onDelete: Cascade)
  status         TicketStatus @default(DRAFT)
  consumedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([holderId, status])
  @@index([eventId, status])
}

model EventReview {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  rating    Int?
  createdAt DateTime @default(now())

  @@unique([eventId, authorId])
  @@index([eventId])
}

model Payment {
  id              String          @id @default(cuid())
  kind            PaymentKind     @default(RESERVATION)
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservationId   String?         @unique
  reservation     Reservation?    @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  likePurchaseId  String?         @unique
  likePurchase    LikePurchase?   @relation(fields: [likePurchaseId], references: [id], onDelete: SetNull)
  provider        PaymentProvider
  status          PaymentStatus   @default(PENDING)
  amountXaf       Int
  currency        String          @default("XAF")
  idempotencyKey  String          @unique
  providerRef     String?
  refundedAmountXaf Int?
  refundedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId, createdAt])
}

model PaymentMethod {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  PaymentProvider
  label     String
  createdAt DateTime        @default(now())
}

enum ConversationKind {
  DIRECT
  GROUP
  EVENT
}

enum MessageKind {
  TEXT
  IMAGE
  AUDIO
  FILE
  STICKER
  INVITE
}

model Conversation {
  id        String             @id @default(cuid())
  kind      ConversationKind
  title     String?
  directKey String?            @unique
  eventId   String?            @unique
  event     Event?             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  members   ConversationMember[]
  messages  Message[]
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime     @default(now())
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId, lastReadAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  kind           MessageKind  @default(TEXT)
  body           String       @default("")
  imageUrl       String?
  audioUrl       String?
  fileUrl        String?
  fileName       String?
  mimeType       String?
  durationMs     Int?
  inviteType     String?
  inviteId       String?
  createdAt      DateTime     @default(now())
  reports        Report[]

  @@index([conversationId, createdAt])
}

enum OfferKind {
  PRODUCT
  SERVICE
}

enum OfferSellerKind {
  PERSON
  SHOP
  BUSINESS
}

enum OfferStatus {
  ACTIVE
  HIDDEN
}

model Offer {
  id          String          @id @default(cuid())
  sellerId    String
  seller      User            @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  kind        OfferKind
  sellerKind  OfferSellerKind @default(PERSON)
  title       String
  description String          @default("")
  shopName    String?
  priceXaf    Int
  currency    String          @default("XAF")
  city        String
  zone        String?
  placeName   String?
  address     String?
  latitude    Float?
  longitude   Float?
  imageUrl    String?
  status      OfferStatus     @default(ACTIVE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([city, status])
  @@index([kind, status])
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model PushPreference {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    Boolean  @default(true)
  social      Boolean  @default(true)
  events      Boolean  @default(true)
  invitations Boolean  @default(true)
  mood        Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

enum ReportKind {
  USER
  POST
  EVENT
  MESSAGE
  MOOD
}

enum ReportReason {
  SPAM
  ABUSE
  FAKE
  OTHER
}

enum ReportStatus {
  OPEN
  DISMISSED
  ACTIONED
}

enum AdminAction {
  USER_BLOCK
  USER_UNBLOCK
  USER_CERTIFY
  USER_UNCERTIFY
  USER_ROLE
  USER_VERIFY
  SESSION_REVOKE
  POST_HIDE
  POST_UNHIDE
  EVENT_CANCEL
  EVENT_APPROVE
  EVENT_SUSPEND
  EVENT_RESTORE
  EVENT_FEATURE
  EVENT_UPDATE
  PAYMENT_REFUND
  REFUND_DENY
  REPORT_REVIEW
  SETTINGS_UPDATE
  FEATURE_FLAG
  NOTIFICATION_SEND
  AI_SETTINGS
  ORGANIZER_RESTRICT
  WORLD_MISSION
}

model Report {
  id           String       @id @default(cuid())
  reporterId   String
  reporter     User         @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  kind         ReportKind
  reason       ReportReason
  body         String       @default("")
  status       ReportStatus @default(OPEN)
  targetUserId String?
  targetUser   User?        @relation("ReportTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  postId       String?
  post         Post?        @relation(fields: [postId], references: [id], onDelete: SetNull)
  eventId      String?
  event        Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  messageId    String?
  message      Message?     @relation(fields: [messageId], references: [id], onDelete: SetNull)
  moodId       String?
  mood         Mood?        @relation(fields: [moodId], references: [id], onDelete: SetNull)
  reviewedById String?
  reviewedBy   User?        @relation("ReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  createdAt    DateTime     @default(now())

  @@index([status, createdAt])
}

model AdminAudit {
  id         String      @id @default(cuid())
  actorId    String
  actor      User        @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action     AdminAction
  entityType String
  entityId   String
  meta       Json?
  createdAt  DateTime    @default(now())

  @@index([createdAt])
}

enum PreferenceSignalKind {
  VIEW_LONG
  SAVED
  SHARED
  FAVORITED
  CLICK_BOOK
  BOOKED
  ATTENDED
  INVITED
  POSITIVE_FEEDBACK
  REPEAT_CATEGORY
  IGNORED
  LEFT_QUICK
  NOT_INTERESTED
  CANCELLED
  NO_SHOW
  REC_IGNORED
}

enum ExperiencePlanStatus {
  DRAFT
  ACTIVE
  CONFIRMED
  CANCELLED
}

enum RecFeedbackKind {
  LIKE
  NOT_INTERESTED
  HIDE_TYPE
  WHY
}

enum AgentSuggestionKind {
  DAILY
  WEEKEND
  TONIGHT
  SOCIAL
  NEW
}

enum MissionKind {
  WEEKEND
  SOCIAL
  DISCOVERY
  FIRST_TIME
}

enum ExperienceMood {
  LOVED
  GOOD
  OK
  DISLIKED
}

model AiConsent {
  userId            String  @id
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  personalizedRecs  Boolean @default(true)
  useHistory        Boolean @default(true)
  socialMatch       Boolean @default(false)
  agentEnabled      Boolean @default(false)
  updatedAt         DateTime @updatedAt
}

model UserPreferenceProfile {
  userId            String   @id
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryScores    Json
  dislikedCategories String[] @default([])
  typicalBudgetXaf  Int?
  maxBudgetXaf      Int?
  preferredHours    Json?
  preferredDays     Int[]    @default([])
  idealDurationMin  Int?
  maxDistanceKm     Float?
  spontaneity       Float?
  groupPreference   String?
  preferredGroupSize Int?
  meetNewPeople     Boolean?
  vibeTags          String[] @default([])
  computedAt        DateTime @default(now())
}

model PreferenceSignal {
  id         String               @id @default(cuid())
  userId     String
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       PreferenceSignalKind
  weight     Float
  category   String?
  eventId    String?
  entityType String?
  entityId   String?
  createdAt  DateTime             @default(now())

  @@index([userId, createdAt])
  @@index([userId, category])
}

model ExperienceRequest {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  rawText   String
  parsed    Json
  createdAt DateTime         @default(now())
  plans     ExperiencePlan[]

  @@index([userId, createdAt])
}

model ExperiencePlan {
  id           String               @id @default(cuid())
  userId       String
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestId    String?
  request      ExperienceRequest?   @relation(fields: [requestId], references: [id], onDelete: SetNull)
  title        String
  status       ExperiencePlanStatus @default(DRAFT)
  surprise     Boolean              @default(false)
  totalCostXaf Int                  @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  steps        ExperiencePlanStep[]
  recs         ExperienceRecommendation[]

  @@index([userId, createdAt])
}

model ExperiencePlanStep {
  id        String         @id @default(cuid())
  planId    String
  plan      ExperiencePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  order     Int
  startsAt  DateTime
  title     String
  category  String
  venue     String?
  city      String?
  zone      String?
  eventId   String?
  costXaf   Int            @default(0)
  travelMin Int            @default(0)
  revealed  Boolean        @default(true)
  bookable  Boolean        @default(false)
  hint      Boolean        @default(false)
  notes     String?

  @@index([planId, order])
}

model ExperienceRecommendation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String?
  planId    String?
  plan      ExperiencePlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  reasonKey String
  reasonParams Json?
  score     Float
  category  String?
  dayKey    String
  createdAt DateTime @default(now())
  feedbacks RecommendationFeedback[]

  @@index([userId, dayKey])
}

model RecommendationFeedback {
  id               String                    @id @default(cuid())
  userId           String
  user             User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendationId String?
  recommendation   ExperienceRecommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)
  eventId          String?
  kind             RecFeedbackKind
  category         String?
  createdAt        DateTime                  @default(now())

  @@index([userId, createdAt])
}

model SocialActivityMatch {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("MatchViewer", fields: [userId], references: [id], onDelete: Cascade)
  peerId    String
  peer      User     @relation("MatchPeer", fields: [peerId], references: [id], onDelete: Cascade)
  category  String
  eventId   String?
  score     Float
  createdAt DateTime @default(now())

  @@index([userId, category, createdAt])
}

model ActivityGroup {
  id              String   @id @default(cuid())
  creatorId       String
  creator         User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  category        String
  title           String
  city            String
  zone            String?
  startsAt        DateTime
  eventId         String?
  conversationId  String?
  status          String   @default("OPEN")
  createdAt       DateTime @default(now())

  @@index([creatorId, createdAt])
  @@index([eventId])
}

model AgentSuggestion {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      AgentSuggestionKind
  title     String
  body      String
  eventIds  String[]            @default([])
  planId    String?
  fromAgent Boolean             @default(true)
  readAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, createdAt])
}

model UserWorldProgress {
  userId         String   @id
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score          Float    @default(0)
  lastComputedAt DateTime @default(now())
}

model CityDiscoveryProgress {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  city            String
  percent         Int      @default(0)
  categoriesTried String[] @default([])
  venuesCount     Int      @default(0)
  attendedCount   Int      @default(0)
  updatedAt       DateTime @updatedAt

  @@unique([userId, city])
}

model CategoryDiscoveryProgress {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   String
  discovered Boolean   @default(false)
  firstAt    DateTime?

  @@unique([userId, category])
}

model Achievement {
  id          String            @id
  titleKey    String
  userUnlocks UserAchievement[]
}

model UserAchievement {
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt    DateTime    @default(now())

  @@id([userId, achievementId])
}

model UserMission {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        MissionKind
  weekKey     String
  progress    Int         @default(0)
  completedAt DateTime?

  @@unique([userId, kind, weekKey])
  @@index([userId, weekKey])
}

model ExperienceFeedback {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String?
  planId    String?
  mood      ExperienceMood
  comment   String?
  isPublic  Boolean         @default(false)
  createdAt DateTime        @default(now())

  @@index([userId, createdAt])
}

enum AdminCampaignStatus {
  DRAFT
  SCHEDULED
  SENT
  CANCELLED
}

model AdminCampaign {
  id          String              @id @default(cuid())
  title       String
  body        String
  status      AdminCampaignStatus @default(DRAFT)
  audience    Json
  scheduledAt DateTime?
  sentAt      DateTime?
  sentCount   Int                 @default(0)
  createdById String
  createdBy   User                @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([status, createdAt])
}

model WorldMission {
  id            String    @id @default(cuid())
  title         String
  description   String    @default("")
  category      String
  durationHours Int?
  conditions    String    @default("")
  reward        String    @default("")
  startsAt      DateTime?
  endsAt        DateTime?
  status        String    @default("DRAFT")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, startsAt])
}

model WebhookReceipt {
  id         String   @id @default(cuid())
  provider   String
  externalId String
  type       String
  status     String
  attempts   Int      @default(1)
  lastError  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([provider, externalId])
  @@index([provider, createdAt])
}
