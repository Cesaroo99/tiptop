generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

enum Availability {
  HIDDEN
  BUSY
  AVAILABLE
}

enum LocationPrecision {
  EXACT
  ZONE
  CITY
  HIDDEN
}

enum PostKind {
  ORGANIC
  SPONSORED
}

enum LikeUnitSource {
  FREE
  PURCHASED
  CERTIFIED_BONUS
}

model AppConfig {
  key   String @id
  value Json
}

model User {
  id               String     @id @default(cuid())
  phoneE164        String     @unique
  phoneCountry     String     @default("CM")
  email            String?    @unique
  username         String     @unique
  firstName        String
  lastName         String
  role             UserRole   @default(USER)
  status           UserStatus @default(ACTIVE)
  certified        Boolean    @default(false)
  profileCompleted Boolean    @default(false)
  locale           String     @default("fr")
  theme            String     @default("light")
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deletedAt        DateTime?

  profile        Profile?
  sessions       Session[]
  devices        Device[]
  otpChallenges  OtpChallenge[]
  posts              Post[]
  likeUnits          LikeUnit[]
  likeReceived       LikeAllocation[] @relation("LikeReceived")
  likePeriodsMade    LikePeriod[]     @relation("LikePeriodActor")
  likePeriodsReceived LikePeriod[]    @relation("LikePeriodBeneficiary")
  likeMilestones     UserMilestone[]
  likeStats          UserLikeStats?
  wishes             Wish[]
  wishOffersMade     WishOffer[]      @relation("WishOfferFrom")
  likePurchases      LikePurchase[]
  likeTransactions   LikeTransaction[] @relation("LikeTxOwner")
  likeTxReceived     LikeTransaction[] @relation("LikeTxTarget")
  payments           Payment[]
  comments           Comment[]
  following          Follow[]         @relation("Following")
  followers          Follow[]         @relation("Followers")
  notifications      Notification[]   @relation("NotifRecipient")
  notificationsActed Notification[]   @relation("NotifActor")
  hostedEvents       Event[]              @relation("EventHost")
  eventParticipations EventParticipant[]
  sentInvitations    Invitation[]         @relation("Inviter")
  receivedInvitations Invitation[]        @relation("Invitee")
  eventHearts        EventHeart[]
  moods              Mood[]
  moodComments       MoodComment[]
  contactsOwned      Contact[]            @relation("ContactOwner")
  contactsOf         Contact[]            @relation("ContactPerson")
  reservations       Reservation[]
  tickets            Ticket[]
  paymentMethods     PaymentMethod[]
  conversationMembers ConversationMember[]
  messages           Message[]
  blocksMade         UserBlock[]          @relation("Blocker")
  blocksReceived     UserBlock[]          @relation("Blocked")
  reportsMade        Report[]             @relation("Reporter")
  reportsAbout       Report[]             @relation("ReportTarget")
  reportsReviewed    Report[]             @relation("ReportReviewer")
  adminAudits        AdminAudit[]
  pushPreference     PushPreference?
  eventReviews       EventReview[]
}

model Profile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio                String?
  profession         String?
  avatarUrl          String?
  coverUrl           String?
  birthDate          DateTime?
  availability       Availability       @default(HIDDEN)
  availabilityUntil  DateTime?
  locationPrecision  LocationPrecision  @default(ZONE)
  country            String             @default("CM")
  city               String?
  zone               String?
  latitude           Float?
  longitude          Float?
  website            String?
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  rememberMe Boolean   @default(false)
  userAgent  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model OtpChallenge {
  id         String    @id @default(cuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  phoneE164  String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phoneE164, createdAt])
}

model Device {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushToken  String?
  platform   String
  lastSeenAt DateTime @default(now())

  @@unique([userId, platform])
}

model Post {
  id        String    @id @default(cuid())
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  kind      PostKind  @default(ORGANIC)
  imageUrl  String?
  city      String?
  zone      String?
  eventId   String?
  event     Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  hiddenAt  DateTime?
  createdAt DateTime  @default(now())
  comments  Comment[]
  reports   Report[]

  @@index([createdAt])
  @@index([hiddenAt])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
}

model LikeUnit {
  id                   String         @id @default(cuid())
  ownerId              String
  owner                User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  source               LikeUnitSource @default(FREE)
  purchaseId           String?
  purchase             LikePurchase?  @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  createdAt            DateTime       @default(now())
  allocations          LikeAllocation[]
  transactions         LikeTransaction[]
  periods              LikePeriod[]

  @@index([ownerId])
  @@index([purchaseId])
}

enum PaymentKind {
  RESERVATION
  LIKE_PACK
}

enum LikeTransactionKind {
  PURCHASE
  ALLOCATE
  RELEASE
}

model LikePurchase {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  packCode  String
  units     Int
  amountXaf Int
  createdAt DateTime          @default(now())
  payment   Payment?
  unitsMade LikeUnit[]
  ledger    LikeTransaction[]

  @@index([userId, createdAt])
}

model LikeTransaction {
  id         String               @id @default(cuid())
  userId     String
  user       User                 @relation("LikeTxOwner", fields: [userId], references: [id], onDelete: Cascade)
  kind       LikeTransactionKind
  delta      Int                  @default(0)
  unitId     String?
  unit       LikeUnit?            @relation(fields: [unitId], references: [id], onDelete: SetNull)
  toUserId   String?
  toUser     User?                @relation("LikeTxTarget", fields: [toUserId], references: [id], onDelete: SetNull)
  purchaseId String?
  purchase   LikePurchase?        @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  createdAt  DateTime             @default(now())

  @@index([userId, createdAt])
}

enum NotificationType {
  LIKE
  COMMENT
  FOLLOW
  INVITE
  TICKET
  PAYMENT
  MESSAGE
  REVIEW
  WISH_OFFER
  LIKE_MILESTONE
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  ENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REFUSED
  EXPIRED
  CANCELLED
}

enum InvitationPayer {
  HOST
  GUEST
  FREE
}

enum ParticipantStatus {
  HOST
  INTERESTED
  RESERVED
  CONFIRMED
  PRESENT
  CANCELLED
}

enum MoodVisibility {
  ZONE
  FOLLOWERS
  EVENT
}

enum TicketStatus {
  DRAFT
  AWAITING_PAYMENT
  CONFIRMED
  CONSUMED
  CANCELLED
  REFUNDED
  EXPIRED
  INVALID
}

enum PaymentProvider {
  CARD
  ORANGE_MONEY
  MTN_MOMO
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum ReservationStatus {
  DRAFT
  AWAITING_PAYMENT
  CONFIRMED
  CANCELLED
  PAST
}

model Follow {
  id         String   @id @default(cuid())
  followerId String
  followeeId String
  follower   User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  followee   User     @relation("Followers", fields: [followeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([followerId, followeeId])
  @@index([followeeId])
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation("NotifRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?            @relation("NotifActor", fields: [actorId], references: [id], onDelete: SetNull)
  type       NotificationType
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  @@index([userId, createdAt])
}

model LikeAllocation {
  id           String    @id @default(cuid())
  unitId       String
  unit         LikeUnit  @relation(fields: [unitId], references: [id], onDelete: Cascade)
  toUserId     String
  toUser       User      @relation("LikeReceived", fields: [toUserId], references: [id], onDelete: Cascade)
  allocatedAt  DateTime  @default(now())
  releasedAt   DateTime?

  @@index([unitId, releasedAt])
  @@index([toUserId, releasedAt])
}

enum LikeTargetType {
  USER
  POST
  COMMENT
  MOOD
  WISH
}

model LikePeriod {
  id                 String         @id @default(cuid())
  unitId             String
  unit               LikeUnit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  actorId            String
  actor              User           @relation("LikePeriodActor", fields: [actorId], references: [id], onDelete: Cascade)
  targetType         LikeTargetType
  targetId           String
  beneficiaryUserId  String
  beneficiary        User           @relation("LikePeriodBeneficiary", fields: [beneficiaryUserId], references: [id], onDelete: Cascade)
  startedAt          DateTime
  endedAt            DateTime?
  weight             Int            @default(1)

  @@index([targetType, targetId, endedAt])
  @@index([beneficiaryUserId, endedAt])
  @@index([actorId, endedAt])
  @@index([unitId, endedAt])
}

model UserMilestone {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestoneId String
  achievedAt  DateTime @default(now())
  notifiedAt  DateTime?

  @@unique([userId, milestoneId])
  @@index([userId])
}

model UserLikeStats {
  userId        String   @id
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  closedSeconds Int      @default(0)
  updatedAt     DateTime @updatedAt
}

enum WishCategory {
  EVENT
  PRODUCT
  RESTAURANT
  ACTIVITY
  TRAVEL
  EXPERIENCE
  GIFT
  SERVICE
  PLACE
  SPORT
  LEISURE
  OTHER
}

enum WishVisibility {
  PUBLIC
  FOLLOWERS
  PRIVATE
}

enum WishPriority {
  LOW
  MEDIUM
  HIGH
}

enum WishOfferStatus {
  SENT
  PENDING
  ACCEPTED
  REFUSED
  AWAITING_PAYMENT
  PAID
  DELIVERED
  DONE
  CANCELLED
}

model Wish {
  id                 String         @id @default(cuid())
  ownerId            String
  owner              User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title              String
  category           WishCategory   @default(OTHER)
  description        String         @default("")
  imageUrl           String?
  url                String?
  estimatedPriceXaf  Int?
  city               String?
  zone               String?
  desiredAt          DateTime?
  eventId            String?
  priority           WishPriority   @default(MEDIUM)
  visibility         WishVisibility @default(PUBLIC)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  offers             WishOffer[]

  @@index([ownerId, createdAt])
}

model WishOffer {
  id        String          @id @default(cuid())
  wishId    String
  wish      Wish            @relation(fields: [wishId], references: [id], onDelete: Cascade)
  fromUserId String
  fromUser  User            @relation("WishOfferFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  message   String          @default("")
  status    WishOfferStatus @default(SENT)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([wishId, createdAt])
  @@index([fromUserId])
}

model Event {
  id                  String      @id @default(cuid())
  hostId              String
  host                User        @relation("EventHost", fields: [hostId], references: [id], onDelete: Cascade)
  title               String
  description         String      @default("")
  imageUrl            String?
  city                String
  zone                String?
  venue               String?
  startsAt            DateTime
  endsAt              DateTime?
  priceXaf            Int         @default(0)
  currency            String      @default("XAF")
  capacity            Int?
  minAge              Int?
  requiresReservation Boolean     @default(false)
  status              EventStatus @default(PUBLISHED)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  participants        EventParticipant[]
  invitations         Invitation[]
  hearts              EventHeart[]
  moods               Mood[]
  posts               Post[]
  reservations        Reservation[]
  tickets             Ticket[]
  conversation        Conversation?
  reports             Report[]
  reviews             EventReview[]

  @@index([startsAt, status])
  @@index([city])
}

model EventParticipant {
  id        String            @id @default(cuid())
  eventId   String
  event     Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    ParticipantStatus
  createdAt DateTime          @default(now())

  @@unique([eventId, userId])
}

model Invitation {
  id          String           @id @default(cuid())
  eventId     String
  event       Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  inviterId   String
  inviter     User             @relation("Inviter", fields: [inviterId], references: [id], onDelete: Cascade)
  inviteeId   String
  invitee     User             @relation("Invitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  payer       InvitationPayer
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  respondedAt DateTime?
  reservation Reservation?

  @@index([inviteeId, status])
  @@index([inviterId])
}

model EventHeart {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId    String
  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  releasedAt DateTime?

  @@index([userId, releasedAt])
  @@index([eventId, releasedAt])
}

model Mood {
  id         String         @id @default(cuid())
  authorId   String
  author     User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body       String         @default("")
  imageUrl   String?
  eventId    String?
  event      Event?         @relation(fields: [eventId], references: [id], onDelete: SetNull)
  visibility MoodVisibility @default(ZONE)
  expiresAt  DateTime
  createdAt  DateTime       @default(now())
  comments   MoodComment[]

  @@index([expiresAt])
}

model MoodComment {
  id        String   @id @default(cuid())
  moodId    String
  mood      Mood     @relation(fields: [moodId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
}

model Contact {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  personId  String
  person    User     @relation("ContactPerson", fields: [personId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([ownerId, personId])
}

model Reservation {
  id            String            @id @default(cuid())
  eventId       String
  event         Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bookerId      String
  booker        User              @relation(fields: [bookerId], references: [id], onDelete: Cascade)
  invitationId  String?           @unique
  invitation    Invitation?       @relation(fields: [invitationId], references: [id], onDelete: SetNull)
  status        ReservationStatus @default(DRAFT)
  seats         Int               @default(1)
  amountXaf     Int               @default(0)
  currency      String            @default("XAF")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  tickets       Ticket[]
  payment       Payment?

  @@index([bookerId, createdAt])
  @@index([eventId, status])
}

model Ticket {
  id             String       @id @default(cuid())
  reservationId  String
  reservation    Reservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  eventId        String
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  holderId       String
  holder         User         @relation(fields: [holderId], references: [id], onDelete: Cascade)
  status         TicketStatus @default(DRAFT)
  consumedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([holderId, status])
  @@index([eventId, status])
}

model EventReview {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  rating    Int?
  createdAt DateTime @default(now())

  @@unique([eventId, authorId])
  @@index([eventId])
}

model Payment {
  id              String          @id @default(cuid())
  kind            PaymentKind     @default(RESERVATION)
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservationId   String?         @unique
  reservation     Reservation?    @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  likePurchaseId  String?         @unique
  likePurchase    LikePurchase?   @relation(fields: [likePurchaseId], references: [id], onDelete: SetNull)
  provider        PaymentProvider
  status          PaymentStatus   @default(PENDING)
  amountXaf       Int
  currency        String          @default("XAF")
  idempotencyKey  String          @unique
  providerRef     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId, createdAt])
}

model PaymentMethod {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  PaymentProvider
  label     String
  createdAt DateTime        @default(now())
}

enum ConversationKind {
  DIRECT
  GROUP
  EVENT
}

enum MessageKind {
  TEXT
  IMAGE
  AUDIO
}

model Conversation {
  id        String             @id @default(cuid())
  kind      ConversationKind
  title     String?
  directKey String?            @unique
  eventId   String?            @unique
  event     Event?             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  members   ConversationMember[]
  messages  Message[]
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime     @default(now())
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId, lastReadAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  kind           MessageKind  @default(TEXT)
  body           String       @default("")
  imageUrl       String?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model PushPreference {
  userId    String  @id
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Boolean @default(true)
  social    Boolean @default(true)
  events    Boolean @default(true)
  updatedAt DateTime @updatedAt
}

enum ReportKind {
  USER
  POST
  EVENT
}

enum ReportReason {
  SPAM
  ABUSE
  FAKE
  OTHER
}

enum ReportStatus {
  OPEN
  DISMISSED
  ACTIONED
}

enum AdminAction {
  USER_BLOCK
  USER_UNBLOCK
  USER_CERTIFY
  USER_UNCERTIFY
  POST_HIDE
  POST_UNHIDE
  EVENT_CANCEL
  PAYMENT_REFUND
  REPORT_REVIEW
}

model Report {
  id           String       @id @default(cuid())
  reporterId   String
  reporter     User         @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  kind         ReportKind
  reason       ReportReason
  body         String       @default("")
  status       ReportStatus @default(OPEN)
  targetUserId String?
  targetUser   User?        @relation("ReportTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  postId       String?
  post         Post?        @relation(fields: [postId], references: [id], onDelete: SetNull)
  eventId      String?
  event        Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  reviewedById String?
  reviewedBy   User?        @relation("ReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  createdAt    DateTime     @default(now())

  @@index([status, createdAt])
}

model AdminAudit {
  id         String      @id @default(cuid())
  actorId    String
  actor      User        @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action     AdminAction
  entityType String
  entityId   String
  meta       Json?
  createdAt  DateTime    @default(now())

  @@index([createdAt])
}
